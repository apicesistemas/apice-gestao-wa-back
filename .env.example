# Servidor (só rede interna; nunca exposto pelo nginx)
SERVER_PORT=3501

# Comunicação com o apice-gestao-back (token de serviço nos dois sentidos)
CRM_BACK_URL=http://127.0.0.1:3500
CRM_BACK_SERVICE_TOKEN=
WA_BACK_ADMIN_TOKEN=
# Prazo (ms) de cada chamada ao back via /interno/* (opcional; padrão 10000)
CRM_BACK_TIMEOUT_MS=10000

# Transcrição de áudio e vídeo
MINIMAX_API_KEY=

# Mídia recebida: tamanho máximo por arquivo (bytes, padrão 16 MB) e prazo total do download (ms, padrão 60 s)
MIDIA_TETO_BYTES=16777216
MIDIA_PRAZO_MS=60000

# Envio do CRM: retenção (ms) dos recibos entregue/lido de uma mensagem enviada, até o back gravá-la (padrão 3000; 0 desliga)
RECIBO_ATRASO_ENVIO_MS=3000
