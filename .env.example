# Servidor (só rede interna; nunca exposto pelo nginx)
SERVER_PORT=3501

# Comunicação com o apice-gestao-back (token de serviço nos dois sentidos)
CRM_BACK_URL=http://127.0.0.1:3500
CRM_BACK_SERVICE_TOKEN=
WA_BACK_ADMIN_TOKEN=
# Prazo (ms) de cada chamada ao back via /interno/* (opcional; padrão 10000)
CRM_BACK_TIMEOUT_MS=10000

# Transcrição de áudio e vídeo
MINIMAX_API_KEY=
