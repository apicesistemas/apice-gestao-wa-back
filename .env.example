# Servidor (só rede interna; nunca publicado pelo proxy (Apache))
SERVER_PORT=3501
# Endereço de escuta: só o loopback (padrão 127.0.0.1). Nunca 0.0.0.0 nem :: (o /ping e o /health não têm token).
# O back chama o wa-back por WA_BACK_BASE_URL=http://127.0.0.1:3501 (não use localhost, que pode resolver para ::1).
SERVER_HOST=127.0.0.1

# Comunicação com o apice-gestao-back (token de serviço nos dois sentidos)
CRM_BACK_URL=http://127.0.0.1:3500
CRM_BACK_SERVICE_TOKEN=
WA_BACK_ADMIN_TOKEN=
# Prazo (ms) de cada chamada ao back via /interno/* (opcional; padrão 10000)
CRM_BACK_TIMEOUT_MS=10000

# Transcrição de áudio e vídeo
MINIMAX_API_KEY=

# Sugestões de texto da IA (Fase 31): modelo de chat da MiniMax. MiniMax-M3 (recomendado, thinking desligado) ou MiniMax-M3.1-Flash (thinking não desliga; usa reasoning_effort low)
MINIMAX_MODELO_TEXTO=MiniMax-M3
# Quantas sugestões podem chamar a MiniMax ao mesmo tempo (a mesma chave serve a transcrição)
MINIMAX_IA_CONCORRENCIA=1
# Avaliação diária da qualidade do atendimento (Fase 55): quantas avaliações em lote podem chamar a MiniMax ao mesmo tempo.
# Portão separado do das sugestões acima, para uma rodada longa nunca atrasar a sugestão do atendente
MINIMAX_IA_CONCORRENCIA_LOTE=1

# Mídia recebida: tamanho máximo por arquivo (bytes, padrão 16 MB) e prazo total do download (ms, padrão 60 s)
MIDIA_TETO_BYTES=16777216
MIDIA_PRAZO_MS=60000

# Envio do CRM: retenção (ms) dos recibos entregue/lido de uma mensagem enviada, até o back gravá-la (padrão 3000; 0 desliga)
RECIBO_ATRASO_ENVIO_MS=3000

# Recibos por destinatário (Fase 38): espera (ms) para juntar os recibos de entrega e leitura num lote para o back (padrão técnico 2000; o lote também sai com 200 itens)
RECIBO_LOTE_MS=2000

# Envio do CRM: prazo (ms) do sendMessage; passado o prazo responde 504 "Envio não confirmado." (padrão 90000, abaixo dos 120 s do back)
ENVIO_PRAZO_MS=90000

# Recuperação na reconexão: janela (ms) das mensagens entregues pela fila offline (append) quando a
# equipe não tem última atividade conhecida (primeiro pareamento ou .cache/atividade-wa.json perdido).
# Com atividade conhecida, recupera tudo desde ela. Padrão 259200000 (72 h, cobre um fim de semana).
RECUPERACAO_JANELA_MS=259200000

# Diagnóstico das chamadas de voz e vídeo (Fase 34, Task 34.0): chave técnica, DESLIGADA por padrão.
# Com S, o log ganha linhas "[DIAG-CHAMADA]" só com a forma dos eventos call e das mensagens (flags e domínios,
# nunca id, telefone, JID, LID ou nome). Não grava nada, não chama o back e não responde ninguém. Desligar: remover ou N.
DIAGNOSTICO_CHAMADAS=N

# Diagnóstico TEMPORÁRIO da presença "digitando" (Fase 56, Task 56.0): DESLIGADO por padrão. Remover depois do roteiro.
# Com DIAGNOSTICO_PRESENCA=S, só para os cod_equipe da lista (separados por vírgula, ex.: 3,5), o log ganha linhas
# "[DIAG_PRESENCA]" só com flags e domínios (nunca JID, LID, telefone, nome ou texto). Não muda o que vai ao back.
# DIAGNOSTICO_PRESENCA=S
# DIAGNOSTICO_PRESENCA_EQUIPES=
# Só para o teste C3: depois do open, manda "available" (o número aparece online e o celular pode ficar sem push).
# DIAGNOSTICO_PRESENCA_ONLINE=S
